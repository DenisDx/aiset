# demo2 environment template (demo2/.env.example).
# run_demo2.sh copies this file to demo2/.env only when it is absent.
# The host parses .env as data and hands it to the aiset resolver; values are
# never copied into logs, API responses, HTML, or saved JSON5.

# -- server ---------------------------------------------------------------
DEMO2_HOST=0.0.0.0
DEMO2_PORT=8383
DEMO2_LOG_LEVEL=info

# -- AI assistant ---------------------------------------------------------
# The model name lives here as well as the URL; both are placeholders in
# config.json5, so no model identifier is hard-coded in the repository.
DEMO2_AI_ENABLED=true
DEMO2_AI_BASE_URL=http://127.0.0.1:11434/v1
DEMO2_AI_API_KEY=
DEMO2_AI_MODEL=qwen3:8b

# -- fixture secrets ------------------------------------------------------
DEMO2_API_TOKEN=
DEMO2_FIXTURE_PASSWORD=